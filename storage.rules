// Reglas de seguridad de Firebase Storage para las imágenes de los posts.
// Pegalas en: Firebase Console → Storage → Reglas.
//
// Igual lógica que Firestore: cualquiera puede VER las imágenes,
// pero solo alguien logueado (vos, el admin) puede SUBIRLAS.

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /posts/{postId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                    && request.resource.size < 8 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }
  }
}
