// Reglas de seguridad de Firestore para Grimm Waves Radio.
// Pegalas en: Firebase Console → Firestore Database → Reglas.
//
// Lógica: cualquiera puede LEER (posts, programación, config de la
// estación son públicos), pero solo un usuario que inició sesión
// (vos, el admin) puede ESCRIBIR.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /posts/{postId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /programs/{programId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
